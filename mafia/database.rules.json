{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[0-9]{4}$/)",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || (newData.child('host').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('players').child(data.child('host').val()).child('online').val() !== true))"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
          }
        },
        "secret": {
          ".read": "auth != null && (root.child('rooms').child($code).child('meta/host').val() === auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === false || root.child('rooms').child($code).child('meta/status').val() === 'end')",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "private": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$day": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true"
            }
          }
        },
        "votes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$day": {
            "$round": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true"
              }
            }
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
        }
      }
    }
  }
}